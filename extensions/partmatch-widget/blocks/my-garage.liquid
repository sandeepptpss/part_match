{% comment %}
  PartMatch – My Garage App Block
  Shows saved vehicles for the customer.
{% endcomment %}

{{ 'partmatch.css' | asset_url | stylesheet_tag }}

<div {{ block.shopify_attributes }}>
  {%- if block.settings.show_heading -%}
    <h3 style="margin-bottom: 12px;">{{ block.settings.heading | default: 'My Garage' }}</h3>
  {%- endif -%}
  <div data-partmatch-garage></div>
</div>

<script src="{{ 'partmatch.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PartMatch My Garage",
  "target": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My Garage"
    }
  ]
}
{% endschema %}
