{% comment %}
  PartMatch – Search Widget App Block
  Place this block on any page, collection, or product template.
{% endcomment %}

{{ 'partmatch.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign pm_heading = block.settings.heading | default: 'Find Your Part'
  assign pm_subheading = block.settings.subheading | default: 'Search by Application'
  assign pm_year_label = block.settings.year_label | default: 'YEAR'
  assign pm_make_label = block.settings.make_label | default: 'MAKE'
  assign pm_model_label = block.settings.model_label | default: 'MODEL'
  assign pm_search_text = block.settings.search_text | default: 'Search'
  assign pm_clear_text = block.settings.clear_text | default: 'Clear'
  assign pm_primary_color = block.settings.primary_color | default: '#008060'
  assign pm_bg_color = block.settings.bg_color | default: '#1a1a1a'
  assign pm_text_color = block.settings.text_color | default: '#ffffff'
  assign pm_border_radius = block.settings.border_radius | default: 4
  assign pm_results_mode = block.settings.results_mode
  assign pm_show_inline = block.settings.show_inline
  assign pm_results_url = block.settings.results_page_url
-%}

<div
  id="partmatch-widget"
  class="pm-widget"
  data-partmatch-widget
  data-results-mode="{{ pm_results_mode }}"
  data-show-inline="{{ pm_show_inline }}"
  data-results-url="{{ pm_results_url }}"
  style="
    --pm-primary: {{ pm_primary_color }};
    --pm-radius: {{ pm_border_radius }}px;
    --pm-btn-radius: {{ pm_border_radius }}px;
    background-color: {{ pm_bg_color }};
    color: {{ pm_text_color }};
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.show_heading -%}
    <p class="pm-widget__heading-small">{{ pm_subheading }}</p>
    <h2 class="pm-widget__heading">
      {{ pm_heading }}
    </h2>
  {%- endif -%}

  <div class="pm-widget__form">
    <div class="pm-widget__select-wrap">
      <select
        data-partmatch-year
        data-placeholder="{{ pm_year_label }}"
        aria-label="{{ pm_year_label }}"
      >
        <option value="" disabled selected>{{ pm_year_label }}</option>
      </select>
    </div>

    <div class="pm-widget__select-wrap">
      <select
        data-partmatch-make
        data-placeholder="{{ pm_make_label }}"
        aria-label="{{ pm_make_label }}"
        disabled
      >
        <option value="" disabled selected>{{ pm_make_label }}</option>
      </select>
    </div>

    <div class="pm-widget__select-wrap">
      <select
        data-partmatch-model
        data-placeholder="{{ pm_model_label }}"
        aria-label="{{ pm_model_label }}"
        disabled
      >
        <option value="" disabled selected>{{ pm_model_label }}</option>
      </select>
    </div>

    <button
      class="pm-btn pm-btn--search"
      data-partmatch-search
      disabled
      style="background: {{ pm_primary_color }};"
    >
      {{ pm_search_text }}
      <span class="pm-spinner" data-partmatch-spinner></span>
    </button>

    <button class="pm-btn pm-btn--clear" data-partmatch-clear>
      {{ pm_clear_text }}
    </button>
  </div>

  <div data-partmatch-results></div>
</div>

<script src="{{ 'partmatch.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PartMatch Search",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "Text Labels"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Part"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Search by Application"
    },
    {
      "type": "text",
      "id": "year_label",
      "label": "Year dropdown label",
      "default": "YEAR"
    },
    {
      "type": "text",
      "id": "make_label",
      "label": "Make dropdown label",
      "default": "MAKE"
    },
    {
      "type": "text",
      "id": "model_label",
      "label": "Model dropdown label",
      "default": "MODEL"
    },
    {
      "type": "text",
      "id": "search_text",
      "label": "Search button text",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "clear_text",
      "label": "Clear button text",
      "default": "Clear"
    },
    {
      "type": "header",
      "content": "Appearance & Colors"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Button color",
      "default": "#008060"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Search Results Options"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_inline",
      "label": "Show results Inline (Instead of redirecting)",
      "default": false
    },
    {
      "type": "url",
      "id": "results_page_url",
      "label": "Results page URL (when not Inline)"
    }
  ]
}
{% endschema %}
