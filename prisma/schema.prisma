// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Shopify Session ──────────────────────────────────────────────────────────
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ─── Fitment Records ─────────────────────────────────────────────────────────
// A FitmentRecord represents one unique Year+Make+Model+Trim combination per shop.
model FitmentRecord {
  id        Int      @id @default(autoincrement())
  shop      String   @db.VarChar(100)
  year      String   @db.VarChar(50)
  make      String   @db.VarChar(100)
  model     String   @db.VarChar(100)
  trim      String   @default("") @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products    FitmentProduct[]
  collections FitmentCollection[]
  tags        FitmentTag[]
  skus        FitmentSku[]

  @@unique([shop, year, make, model, trim])
  @@index([shop])
  @@index([shop, year])
  @@index([shop, year, make])
  @@index([shop, year, make, model])
}

// ─── Fitment ↔ Product Junction ──────────────────────────────────────────────
// Links a FitmentRecord to one or more Shopify product GIDs.
model FitmentProduct {
  id               Int    @id @default(autoincrement())
  fitmentId        Int
  shopifyProductId String // Shopify GID e.g. "gid://shopify/Product/123"
  shopifyHandle    String @default("")
  productTitle     String @default("")

  fitment FitmentRecord @relation(fields: [fitmentId], references: [id], onDelete: Cascade)

  @@unique([fitmentId, shopifyProductId])
  @@index([fitmentId])
  @@index([shopifyProductId])
}

// ─── Fitment ↔ Collection Junction ───────────────────────────────────────────
// Links a FitmentRecord to entire Shopify Collections by GID or handle.
model FitmentCollection {
  id                  Int    @id @default(autoincrement())
  fitmentId          Int
  shopifyCollectionId String // Shopify GID e.g. "gid://shopify/Collection/123"
  shopifyHandle       String @default("")
  collectionTitle     String @default("")

  fitment FitmentRecord @relation(fields: [fitmentId], references: [id], onDelete: Cascade)

  @@unique([fitmentId, shopifyCollectionId])
  @@index([fitmentId])
  @@index([shopifyCollectionId])
}

// ─── Fitment ↔ Tag Junction ──────────────────────────────────────────────────
// Links a FitmentRecord to product Tags.
model FitmentTag {
  id        Int    @id @default(autoincrement())
  fitmentId Int
  tag       String // e.g. "bmw-m2" or "2000-fitment"

  fitment FitmentRecord @relation(fields: [fitmentId], references: [id], onDelete: Cascade)

  @@unique([fitmentId, tag])
  @@index([fitmentId])
  @@index([tag])
}

// ─── Fitment ↔ SKU Junction ──────────────────────────────────────────────────
// Links a FitmentRecord directly to Product SKUs.
model FitmentSku {
  id        Int    @id @default(autoincrement())
  fitmentId Int
  sku       String @db.VarChar(100)

  fitment FitmentRecord @relation(fields: [fitmentId], references: [id], onDelete: Cascade)

  @@unique([fitmentId, sku])
  @@index([fitmentId])
  @@index([sku])
}

// ─── Universal Products ───────────────────────────────────────────────────────
// Products compatible with ALL vehicles for a shop.
model UniversalProduct {
  id               Int    @id @default(autoincrement())
  shop             String @db.VarChar(100)
  shopifyProductId String
  shopifyHandle    String @default("")
  productTitle     String @default("")

  @@unique([shop, shopifyProductId])
  @@index([shop])
}

// ─── Search Logs ─────────────────────────────────────────────────────────────
// Every storefront search is logged for analytics.
model SearchLog {
  id           Int      @id @default(autoincrement())
  shop         String   @db.VarChar(100)
  year         String   @db.VarChar(50)
  make         String   @db.VarChar(100)
  model        String   @db.VarChar(100)
  trim         String   @default("") @db.VarChar(100)
  resultCount  Int      @default(0)
  hasResults   Boolean  @default(false)
  sessionId    String?  // browser session / customer identifier
  createdAt    DateTime @default(now())

  @@index([shop])
  @@index([shop, hasResults])
  @@index([shop, createdAt])
  @@index([shop, year, make, model])
}

// ─── Widget Settings ─────────────────────────────────────────────────────────
// Per-shop widget customization preferences.
model WidgetSettings {
  id              Int    @id @default(autoincrement())
  shop            String @unique
  heading         String @default("FIND YOUR PART")
  subheading      String @default("SEARCH BY APPLICATION")
  yearLabel       String @default("YEAR")
  makeLabel       String @default("MAKE")
  modelLabel      String @default("MODEL")
  trimLabel       String @default("TRIM / ENGINE")
  vinSearchLabel  String @default("SEARCH BY VIN")
  searchButtonText String @default("SEARCH")
  clearButtonText  String @default("CLEAR")
  voiceSearchButtonText String @default("ASK AI")
  voiceSearchTabText    String @default("AI VOICE SEARCH")
  voiceSearchPlaceholder String @default("e.g. Front brake pads for 2018 Honda Civic EX...")
  primaryColor    String @default("#0f172a")
  textColor       String @default("#0f172a")
  backgroundColor String @default("#ffffff")
  borderRadius    Int    @default(6)
  layout          String @default("horizontal") // horizontal | stacked
  showHeading     Boolean @default(true)
  showSubheading  Boolean @default(true)
  enableVinSearch Boolean @default(true)
  enableYmmSearch Boolean @default(true)
  enableVoiceSearch Boolean @default(true)
  backgroundImage String  @default("")
  bgOverlayOpacity Int    @default(0)
  enableBgImage   Boolean @default(false)
  widgetMaxWidth  Int     @default(1000)
  bannerMinHeight Int     @default(220)
  bannerPaddingVertical Int @default(30)
  bgImageSize     String  @default("cover")

  @@index([shop])
}

// ─── Saved Vehicles (My Garage) ───────────────────────────────────────────────
// Vehicles a logged-in customer has saved, synced across devices.
// Guest (not-logged-in) customers keep using localStorage only.
model SavedVehicle {
  id         Int      @id @default(autoincrement())
  shop       String   @db.VarChar(100)
  customerId String   @db.VarChar(100)
  year       String   @db.VarChar(50)
  make       String   @db.VarChar(100)
  model      String   @db.VarChar(100)
  trim       String   @default("") @db.VarChar(100)
  createdAt  DateTime @default(now())

  @@unique([shop, customerId, year, make, model, trim])
  @@index([shop, customerId])
}

// ─── App Settings ────────────────────────────────────────────────────────────
// Per-shop search behavior / product display / customer selection toggles.
model AppSettings {
  id                  Int     @id @default(autoincrement())
  shop                String  @unique
  requireYear         Boolean @default(true)
  requireAllFields    Boolean @default(true)
  logNoResults        Boolean @default(true)
  includeUniversal    Boolean @default(true)
  redirectOnSearch    Boolean @default(false)
  resultsUrl          String  @default("/pages/find-your-part")
  persistSelection    Boolean @default(true)
  enableGarage        Boolean @default(true)
  enableTrim          Boolean @default(true)
  enableVinSearch     Boolean @default(true)
  enablePdpBadges     Boolean @default(true)
  showFitmentChecker  Boolean @default(true)
  themeExtensionConfirmed Boolean @default(false)
  annualDiscountPercent Int   @default(20)
  merchantDiscountPercent Int @default(0)
  isSupportOnline     Boolean @default(true)

  // ─── Special VIP Offers & Volume Discounts ──────────────────────────────
  vipFreeOfferActive      Boolean   @default(false)
  vipFreeOfferMonths      Int       @default(2)
  vipFreeOfferStoreLimit  Int       @default(10)
  vipFreeOfferGrantedAt   DateTime?
  vipFreeOfferClaimed     Boolean   @default(false)
  autoGrantFirst10        Boolean   @default(false)
  volumeDiscountThreshold Int       @default(10)
  volumeDiscountPercent   Int       @default(25)
  isVolumeDiscountActive  Boolean   @default(true)

  // ─── VIN Safety & Budget Alert Settings ──────────────────────────────
  vinCapEnabled           Boolean   @default(true)
  vinMonthlyCapLimit      Int       @default(50)
  vinAlertEmail           String    @default("")

  @@index([shop])
}

// ─── Shop Plan ────────────────────────────────────────────────────────────────
// Cached copy of the shop's active Shopify billing subscription, kept in sync
// by the Plans page loader (live billing.check) and the app_subscriptions/update webhook.
model ShopPlan {
  shop           String   @id
  plan           String   @default("free") // "free" | "growth" | "enterprise"
  billingCycle   String   @default("monthly") // "monthly" | "annual"
  subscriptionId String?
  updatedAt      DateTime @updatedAt
}

// ─── VIN Lookup Usage Logs ──────────────────────────────────────────────────
// Tracks VIN lookups per shop for usage-based billing / limit monitoring.
model VinLookupLog {
  id        Int      @id @default(autoincrement())
  shop      String   @db.VarChar(100)
  vin       String   @db.VarChar(17)
  vehicle   String   @default("") @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([shop])
  @@index([shop, createdAt])
}

